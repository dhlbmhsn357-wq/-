<?xml version="1.0" encoding="utf-8"?>
<!-- Backup + device-transfer rules (API 31+). Exclude the Keystore-backed secure store (device key)
     from both cloud backup and device-to-device transfer. The Keystore master key never leaves the
     device, so even an accidental copy would be undecryptable — this makes the exclusion explicit. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="ayyam_secure_store.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="ayyam_secure_store.xml" />
    </device-transfer>
</data-extraction-rules>
